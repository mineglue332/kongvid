# Kongvid environment
JWT_SECRET=ganti-dengan-secret-acak
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_REDIRECT=http://localhost:3000/login/callback

# Midtrans (Dashboard -> Settings -> Web & API Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Pasang webhook URL: https://domainmu/api/payment/webhook

# Engine
YTDLP_PATH=yt-dlp
# Opsional: lewati cek bot YouTube dari server (lihat README)
YTDLP_EXTRA_ARGS=
FFMPEG_PATH=ffmpeg
